# Backend Environment Variables Example

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# PostgreSQL + PostGIS Database Connection (Prisma)
DATABASE_URL="postgresql://careersync:careersync_dev_password@localhost:5432/careersync?schema=public"

# Database Configuration Details
POSTGRES_USER=careersync
POSTGRES_PASSWORD=careersync_dev_password
POSTGRES_DB=careersync
POSTGRES_PORT=5432

# Redis Infrastructure & Caching Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379
REDIS_TTL_DEFAULT=3600

# Storage Provider Configuration (local, cloudinary, s3)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=uploads/resumes

# Authentication Secrets
JWT_ACCESS_SECRET=replace-with-secure-development-access-secret
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=replace-with-secure-development-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

COOKIE_SECURE=false
